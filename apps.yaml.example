# Copy to apps/apps.yaml (Exclusive Session) or beside ha_smart_hvac/ under AppDaemon
# app_dir (manual install or Production). Replace YOUR_* placeholders with house entity IDs.
# apps/apps.yaml is gitignored — do not commit live entity IDs.
#
# Demand SWT follows weather_feedforward (base/slope/comfort_ref) + Outdoor under
# Plant Management / Heating Demand — the only water-law commission. Not
# house-proven; retune under operator HITL. Mild Outdoor with defaults base=37 /
# slope=0.9 / comfort_ref=20 can pin SWT to setpoint_min (e.g. ~10 °C → u_ff≈46,
# still below 50) until rails HITL.
hvac:
  module: ha_smart_hvac
  class: HvacApp
  outdoor_temperature: sensor.YOUR_OUTDOOR_TEMPERATURE
  plant_management: switch.YOUR_PLANT_MANAGEMENT
  plant_setpoint: number.YOUR_PLANT_SETPOINT
  setpoint_min: 50
  setpoint_max: 60
  control_interval: 300
  weather_feedforward:
    base: 37
    slope: 0.9
    comfort_ref: 20
  zones:
    - name: zone_one
      temperature: sensor.YOUR_ZONE_ONE_TEMPERATURE
      weight: 1.0
      thermostats:
        - climate.YOUR_ZONE_ONE_THERMOSTAT
