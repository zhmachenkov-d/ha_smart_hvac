# Copy to apps/apps.yaml (Exclusive Session) or beside ha_smart_hvac/ under AppDaemon
# app_dir (HACS/Production). Replace YOUR_* placeholders with house entity IDs.
# apps/apps.yaml is gitignored — do not commit live entity IDs.
hvac:
  module: ha_smart_hvac
  class: HvacApp
  outdoor_temperature: sensor.YOUR_OUTDOOR_TEMPERATURE
  plant_management: switch.YOUR_PLANT_MANAGEMENT
  plant_setpoint: number.YOUR_PLANT_SETPOINT
  setpoint_min: 40
  setpoint_max: 55
  control_interval: 60
  weather_feedforward:
    base: 25
    slope: 1.2
    comfort_ref: 20
    # Optional auto_correct nest — omit nest = E2 defaults (auto-correct always on).
    # Ops: delete ff_auto_correct_state.json under app_dir to restore yaml commission.
    # auto_correct:
    #   outdoor_gate_delta_k: 12
    #   r_expected_c_per_h: 0.25
    #   near_setpoint_eps_k: 0.3
    #   e_sat_c_per_h: 0.25
  zones:
    - name: zone_one
      temperature: sensor.YOUR_ZONE_ONE_TEMPERATURE
      thermostats:
        - climate.YOUR_ZONE_ONE_THERMOSTAT
