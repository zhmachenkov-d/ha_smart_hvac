# Copy to apps/apps.yaml (Exclusive Session) or beside ha_smart_hvac/ under AppDaemon
# app_dir (manual install or Production). Replace YOUR_* placeholders with house entity IDs.
# apps/apps.yaml is gitignored — do not commit live entity IDs.
#
# base_water_temp / pid / control_interval / zone weight below are C4 starting
# commission defaults — not house-proven; retune under operator HITL after epic 2 docs.
hvac:
  module: ha_smart_hvac
  class: HvacApp
  plant_management: switch.YOUR_PLANT_MANAGEMENT
  plant_setpoint: number.YOUR_PLANT_SETPOINT
  setpoint_min: 40
  setpoint_max: 55
  control_interval: 300
  base_water_temp: 40
  # kp: °C water per °C air error. ki: 1/h (∫ is °C·h). i_term_*: bounds on
  # ki·∫ in °C of water — independent of control_interval.
  # boiler_water: sensor.YOUR_BOILER_WATER  # required when pid.adaptive is true
  pid:
    kp: 1.0
    ki: 1.0
    i_term_min: -10
    i_term_max: 15
    adaptive: false
  zones:
    - name: zone_one
      temperature: sensor.YOUR_ZONE_ONE_TEMPERATURE
      weight: 1.0
      thermostats:
        - climate.YOUR_ZONE_ONE_THERMOSTAT
